---
/**
 * Pricing from site.config.ts (pricing.plans), on the homepage and /pricing. Started from the
 * library's Pricing34; its class names and styles are kept so the craft layer still applies.
 *
 * fake-door: "Choose plan" records the click (POST /api/intent with the cloudflare provider, and
 *   the plan_intent event), then opens a dialog that says the plan is not on sale yet — no payment
 *   is taken — and offers the waitlist.
 * checkout: each paid plan links to its hosted checkout.
 */
import Button from "../ui/Button.astro";
import Dialog from "../ui/Dialog.astro";
import LeadForm from "../cta/LeadForm.astro";
import { site } from "../../site.config";

interface Props {
  tagline?: string;
  heading: string;
  description?: string;
  /** Unique per page, so two pricing blocks never share a dialog. */
  id?: string;
  /** h1 when the section is the page (/pricing), h2 inside the homepage. */
  headingLevel?: "h1" | "h2";
}

const { tagline, heading, description, id = "pricing", headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;
const { mode, plans, disclosure } = site.pricing;
const fakeDoor = mode === "fake-door";
const intentEndpoint = site.leads.provider.id === "cloudflare" ? "/api/intent" : null;
const waitlistLabel = site.cta.primary.type === "waitlist" ? site.cta.primary.label : "Notify me";
---
<section class="pricing-34" id={id} data-pricing={JSON.stringify({ intentEndpoint })}>
  <div class="pricing-34__container">
    <div class="pricing-34__head">
      <div class="pricing-34__title">
        {tagline && <p class="pricing-34__tagline">{tagline}</p>}
        <div class="pricing-34__title-content">
          <Heading class="pricing-34__heading">{heading}</Heading>
          {description && <p class="pricing-34__description">{description}</p>}
        </div>
      </div>
    </div>
    <div class="pricing-34__pane">
      {plans.map((plan) => (
        <div class:list={["pricing-34__card", plan.highlighted && "pricing-34__card--highlighted"]}>
          {plan.badge && <span class="pricing-34__badge">{plan.badge}</span>}
          <div class="pricing-34__plan-title">
            <h3 class="pricing-34__plan-name">{plan.name}</h3>
            {plan.description && <p class="pricing-34__plan-description">{plan.description}</p>}
          </div>
          <hr class="pricing-34__divider" />
          <div class="pricing-34__price-content">
            <div class="pricing-34__price-block">
              <p class="pricing-34__price">{plan.price}{plan.period && <span class="pricing-34__period">{plan.period}</span>}</p>
              {plan.note && <p class="pricing-34__note">{plan.note}</p>}
            </div>
            <div class="pricing-34__actions">
              {fakeDoor ? (
                <Button label={plan.cta} variant={plan.highlighted ? "primary" : "secondary"} data-plan-intent={plan.id} data-plan-name={plan.name} data-dialog-open={`${id}-disclosure`} aria-haspopup="dialog" />
              ) : plan.checkoutUrl ? (
                <Button label={plan.cta} href={plan.checkoutUrl} variant={plan.highlighted ? "primary" : "secondary"} data-cta="checkout" />
              ) : (
                <Button label={plan.cta} href="/#get-started" variant={plan.highlighted ? "primary" : "secondary"} />
              )}
            </div>
          </div>
          <hr class="pricing-34__divider" />
          <ul class="pricing-34__features">
            {plan.features.map((feature) => (
              <li class="pricing-34__feature">
                <svg class="pricing-34__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7" /></svg>
                <span>{feature}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

{fakeDoor && (
  <Dialog id={`${id}-disclosure`} title={disclosure.dialogTitle} description={disclosure.dialogText}>
    <p class="-mt-2 text-md text-ink-secondary" data-plan-picked></p>
    <LeadForm id={`${id}-waitlist`} kind="waitlist" submitLabel={waitlistLabel} layout="inline" />
  </Dialog>
)}

<script>
  import { track } from "../../lib/analytics";

  for (const block of document.querySelectorAll<HTMLElement>("[data-pricing]")) {
    const { intentEndpoint } = JSON.parse(block.dataset.pricing ?? "{}") as { intentEndpoint: string | null };
    block.addEventListener("click", (event) => {
      const button = event.target instanceof Element ? event.target.closest<HTMLElement>("[data-plan-intent]") : null;
      if (!button) return;
      const plan = button.dataset.planIntent ?? "";
      track("plan_intent", { plan });
      if (intentEndpoint) {
        void fetch(intentEndpoint, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ plan, page: location.pathname }), keepalive: true }).catch(() => undefined);
      }
      const picked = document.querySelector(`#${CSS.escape(button.dataset.dialogOpen ?? "")} [data-plan-picked]`);
      if (picked) picked.textContent = `You chose ${button.dataset.planName ?? plan}.`;
    });
  }
</script>

<style>
  .pricing-34 {
    padding: var(--space-section-vertical-l) var(--space-section-horizontal-l);
    background: var(--bg-main);
  }
  .pricing-34__container {
    display: flex;
    flex-direction: column;
    gap: var(--space-48);
    width: 100%;
    max-width: var(--size-container-l);
    margin-inline: auto;
  }
  .pricing-34__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-48);
    width: 100%;
  }
  .pricing-34__title {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    width: 100%;
    max-width: var(--size-measure-l);
  }
  .pricing-34__tagline {
    margin: 0;
    color: var(--text-main);
    font-size: var(--font-body-m-size);
    line-height: var(--font-body-m-line-height);
    font-weight: 600;
  }
  .pricing-34__title-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
  }
  .pricing-34__heading {
    margin: 0;
    color: var(--text-main);
    font-size: var(--font-titles-h2-size);
    line-height: var(--font-titles-h2-line-height);
    font-weight: 700;
  }
  .pricing-34__description {
    margin: 0;
    color: var(--text-main);
    font-size: var(--font-body-l-size);
    line-height: var(--font-body-l-line-height);
  }
  .pricing-34__pane {
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
    width: 100%;
  }
  .pricing-34__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
    min-width: 0;
    padding: var(--space-24);
    background: var(--bg-secondary);
    border: 1px solid var(--line-tertiary);
    border-radius: var(--radius-4);
  }
  .pricing-34__card--highlighted {
    border-color: var(--line-accent);
  }
  .pricing-34__card {
    justify-content: space-between;
  }
  .pricing-34__plan-title {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .pricing-34__price-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }
  .pricing-34__price-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  .pricing-34__plan-description {
    margin: 0;
    color: var(--text-main);
    font-size: var(--font-body-l-size);
    line-height: var(--font-body-l-line-height);
    font-weight: 400;
  }
  .pricing-34__divider {
    width: 100%;
    margin: 0;
    border: 0;
    border-top: 1px solid var(--line-tertiary);
  }
  .pricing-34__plan-name {
    margin: 0;
    color: var(--text-main);
    font-size: var(--font-body-xl-size);
    line-height: var(--font-body-xl-line-height);
    font-weight: 700;
  }
  .pricing-34__price {
    margin: 0;
    color: var(--text-main);
    font-size: var(--font-titles-h1-size);
    line-height: var(--font-titles-h1-line-height);
    font-weight: 700;
  }
  .pricing-34__note {
    margin: 0;
    color: var(--text-main);
    font-size: var(--font-body-l-size);
    line-height: var(--font-body-l-line-height);
    font-weight: 400;
  }
  .pricing-34__features {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    margin: 0;
    padding: var(--space-8) 0;
    list-style: none;
  }
  .pricing-34__feature {
    display: flex;
    align-items: flex-start;
    gap: var(--space-16);
    color: var(--text-main);
    font-size: var(--font-body-l-size);
    line-height: var(--font-body-l-line-height);
  }
  .pricing-34__check {
    flex: none;
    width: var(--space-24);
    height: var(--space-24);
    color: var(--icon-main);
  }
  .pricing-34__actions {
    display: grid;
    gap: var(--space-16);
  }

  @media (min-width: 768px) {
    .pricing-34__container {
      gap: var(--space-72);
    }
    .pricing-34__head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--space-72);
    }
    .pricing-34__title {
      gap: var(--space-16);
    }
    .pricing-34__title-content {
      gap: var(--space-24);
    }
    .pricing-34__description {
      font-size: var(--font-body-xl-size);
      line-height: var(--font-body-xl-line-height);
    }
    .pricing-34__pane {
      flex-direction: row;
      align-items: stretch;
      gap: var(--space-24);
    }
    .pricing-34__card {
      flex: 1 1 0;
      padding: var(--space-24);
    }
    .pricing-34__price-content {
      gap: var(--space-32);
    }
  }
</style>
