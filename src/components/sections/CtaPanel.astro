---
/**
 * The closing call to action on a coloured panel. Started from the library's Cta3 (cta-3,
 * centred, default surface): its class names and styles are kept, so the craft layer's violet
 * panel still applies. The calls to action come from site.config.ts, in the dark tone.
 */
import Cta from "../cta/Cta.astro";
import SignupCount from "../cta/SignupCount.astro";
import { ctaFits } from "../../lib/layout";
import { site } from "../../site.config";

interface Props {
  heading: string;
  description: string;
}

const { heading, description } = Astro.props;
const { primary } = site.cta;
// A link to a homepage section the layout leaves out (e.g. #how-it-works in "minimal") is dropped.
const secondary = ctaFits(site.cta.secondary) ? site.cta.secondary : undefined;
const formFirst = primary.type === "waitlist";
---
<section class="cta-3 cta-3--default cta-3--center">
  <div class="cta-3__container">
    <div class="cta-3__column">
      <div class="cta-3__content">
        <h2 class="cta-3__heading">{heading}</h2>
        <p class="cta-3__description">{description}</p>
      </div>
      <div class:list={["cta-3__actions", formFirst && "cta-3__actions--form"]}>
        <Cta cta={primary} id="panel-cta" tone="dark" />
        {secondary && !formFirst && <Cta cta={secondary} id="panel-cta-secondary" variant="secondary" tone="dark" />}
        <SignupCount tone="dark" />
      </div>
    </div>
  </div>
</section>

<style>
  .cta-3 {
    padding: var(--space-section-vertical-l) var(--space-section-horizontal-l);
    background: var(--bg-main);
  }
  .cta-3__container {
    width: 100%;
    max-width: var(--size-container-l);
    margin-inline: auto;
  }
  .cta-3--tertiary {
    background: var(--bg-tertiary);
  }
  .cta-3--image {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--bg-decorative);
  }
  .cta-3__background {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--bg-tertiary);
  }
  .cta-3__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--bg-main-transparent);
    opacity: 0.5;
  }
  .cta-3--image .cta-3__container {
    position: relative;
  }
  .cta-3__column {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    width: 100%;
    max-width: var(--size-measure-l);
  }
  .cta-3__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
  }
  .cta-3__heading {
    margin: 0;
    color: var(--text-main);
    font-size: var(--font-titles-h2-size);
    line-height: var(--font-titles-h2-line-height);
    font-weight: 700;
  }
  .cta-3__description {
    margin: 0;
    color: var(--text-main);
    font-size: var(--font-body-l-size);
    line-height: var(--font-body-l-line-height);
    font-weight: 400;
  }
  .cta-3__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-16);
    width: fit-content;
    align-self: flex-start;
  }
  .cta-3--center .cta-3__column {
    margin-inline: auto;
    text-align: center;
  }
  .cta-3--center .cta-3__actions,
  .cta-3--center .cta-3__form-actions {
    align-self: center;
  }

  @media (min-width: 768px) {
    .cta-3__column {
      gap: var(--space-32);
    }
    .cta-3__content {
      gap: var(--space-24);
    }
    .cta-3__description {
      font-size: var(--font-body-xl-size);
      line-height: var(--font-body-xl-line-height);
    }
  }
</style>
