---
/**
 * The homepage. Copy lives in the section constants below; calls to action and leads come from
 * src/site.config.ts. `layout` there picks which sections show, in which order:
 *   minimal  hero (with the form) → FAQ
 *   product  hero → how it works → stats panel → what's inside → fake door → pricing → FAQ → CTA
 *   story    hero → problem → solution → how it works → pricing → FAQ → CTA
 * Each section keeps its data-section number in every layout (the mockup images below key on it).
 */
import type { ComponentProps } from "astro/types";
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/site/SiteHeader.astro";
import SiteFooter from "../components/site/SiteFooter.astro";
import Hero from "../components/sections/Hero.astro";
import Feature459 from "../components/library/Feature459.astro";
import StatsSection2 from "../components/library/StatsSection2.astro";
import Feature155 from "../components/library/Feature155.astro";
import Feature4 from "../components/library/Feature4.astro";
import Pricing from "../components/sections/Pricing.astro";
import Faq2 from "../components/library/Faq2.astro";
import CtaPanel from "../components/sections/CtaPanel.astro";
import { site } from "../site.config";
import { siteUrl } from "../lib/url";
// Feature icons: Lucide (ISC), inlined at build time.
import iconMailCheck from "lucide-static/icons/mail-check.svg?raw";
import iconListChecks from "lucide-static/icons/list-checks.svg?raw";
import iconMessageSquareText from "lucide-static/icons/message-square-text.svg?raw";
import iconBellOff from "lucide-static/icons/bell-off.svg?raw";
import iconMailX from "lucide-static/icons/mail-x.svg?raw";
import iconHourglass from "lucide-static/icons/hourglass.svg?raw";
import iconCalendarX from "lucide-static/icons/calendar-x.svg?raw";
import iconBanknote from "lucide-static/icons/banknote.svg?raw";

const { layout } = site;
/** A wrapper's style that hands its section a product mockup, light and dark (see the style block at the end). */
const mockup = (name: string): string => `display: contents; --mockup: url("/images/${name}.svg"); --mockup-dark: url("/images/${name}-dark.svg")`;

// The sample content below is a made-up product, Paylark (polite reminders for unpaid invoices), so the
// page reads like a real demand test. Replace it with your own product's words (/validate-setup does it).
const section2: ComponentProps<typeof Hero> = {
  "pill": "Early access",
  "heading": "Invoices that chase themselves",
  "description": "Paylark sends polite reminders on the schedule you set and stops the moment your client pays.",
  "imageAlt": "The Paylark invoice list: amounts, reminders sent and status for each client, beside the next reminder email"
};
const section3: ComponentProps<typeof Feature459> = {
  "heading": "How it works",
  "features": [
    {
      "icon": "<svg viewBox=\"0 0 48 48\" aria-hidden=\"true\"><rect width=\"48\" height=\"48\" rx=\"12\" fill=\"var(--bg-accent)\"/><text x=\"24\" y=\"31\" text-anchor=\"middle\" font-size=\"20\" font-weight=\"700\" fill=\"var(--text-reverse)\">1</text></svg>",
      "title": "Add an invoice",
      "text": "Forward the invoice email or upload a CSV. Paylark reads the client, the amount and the due date."
    },
    {
      "icon": "<svg viewBox=\"0 0 48 48\" aria-hidden=\"true\"><rect width=\"48\" height=\"48\" rx=\"12\" fill=\"var(--bg-accent)\"/><text x=\"24\" y=\"31\" text-anchor=\"middle\" font-size=\"20\" font-weight=\"700\" fill=\"var(--text-reverse)\">2</text></svg>",
      "title": "Pick the schedule",
      "text": "Choose when reminders go out and how they sound, from a friendly nudge before the due date to a firm note ten days late."
    },
    {
      "icon": "<svg viewBox=\"0 0 48 48\" aria-hidden=\"true\"><rect width=\"48\" height=\"48\" rx=\"12\" fill=\"var(--bg-accent)\"/><text x=\"24\" y=\"31\" text-anchor=\"middle\" font-size=\"20\" font-weight=\"700\" fill=\"var(--text-reverse)\">3</text></svg>",
      "title": "Get paid",
      "text": "When the client pays, the reminders for that invoice stop. You never have to write the awkward email yourself."
    }
  ],
  "imageAlt": "Three steps: an invoice read from a forwarded PDF, a four-step reminder schedule, and the invoice marked as paid"
};
const section4: ComponentProps<typeof StatsSection2> = {
  "variant": "card",
  "heading": "One job, done every time",
  "description": "Paylark follows up on unpaid invoices. It doesn't send invoices, take payments or touch your accounting.",
  "stats": [
    {
      "value": "4",
      "label": "Reminder steps",
      "description": "Before the due date, on the day, then five and ten days late. Move or remove any of them."
    },
    {
      "value": "3",
      "label": "Tones",
      "description": "Friendly, neutral or firm, set per step. Every message can be read and edited before it goes out."
    },
    {
      "value": "0",
      "label": "Payment fees",
      "description": "Clients pay you the way they do today. Paylark adds your payment link and never holds the money."
    },
    {
      "value": "1",
      "label": "Click to pause",
      "description": "A client asked for more time? Pause their reminders until you resume them."
    }
  ]
};
// story only: the problem the page solves, before the solution (section 4).
const problem: ComponentProps<typeof Feature155> = {
  "tagline": "The problem",
  "heading": "Getting paid shouldn’t be a second job",
  "description": "Most late invoices aren’t disputes. They slip because nobody followed up in time.",
  "features": [
    {
      "icon": iconMailX,
      "title": "The email you put off",
      "text": "Asking for money you’ve already earned feels awkward, so the reminder waits another week."
    },
    {
      "icon": iconHourglass,
      "title": "Follow-ups that slip",
      "text": "The note you meant to send on Monday goes out on Thursday, if it goes out at all."
    },
    {
      "icon": iconCalendarX,
      "title": "Due dates in five places",
      "text": "Your inbox, a spreadsheet and your memory each hold part of who owes what."
    },
    {
      "icon": iconBanknote,
      "title": "Cash you can’t plan",
      "text": "Without steady follow-ups, you can’t tell when the money will arrive."
    }
  ],
  "primaryLabel": "See how Paylark helps",
  "secondaryLabel": "How it works",
  "primaryHref": "#solution",
  "secondaryHref": "#how-it-works"
};
const section5: ComponentProps<typeof Feature155> = {
  "surface": "tertiary",
  "tagline": "Features",
  "heading": "Everything a reminder needs, nothing it doesn’t",
  "description": "Paylark does one job: it follows up on unpaid invoices so you don’t have to.",
  "features": [
    {
      "icon": iconMailCheck,
      "title": "Sent in your name",
      "text": "Reminders go out from your own address and signature, and replies land in your inbox."
    },
    {
      "icon": iconListChecks,
      "title": "See who owes what",
      "text": "One list of open invoices, with the reminders already sent and the next one for each client."
    },
    {
      "icon": iconMessageSquareText,
      "title": "Firm, never rude",
      "text": "Choose the tone of each step and edit any message before it goes out."
    },
    {
      "icon": iconBellOff,
      "title": "Stops when they pay",
      "text": "Mark an invoice paid, or let your payment link report it, and the reminders stop."
    }
  ],
  "primaryLabel": "Compare plans",
  "secondaryLabel": "Read the FAQ",
  "primaryHref": "/pricing/",
  "secondaryHref": "#faq"
};
const section6: ComponentProps<typeof Feature4> = {
  "tagline": "Pricing preview",
  "heading": "Help us set the price",
  "text": "Paylark isn’t built yet. Choose the plan you’d pay for and we’ll tell you right away that it isn’t on sale. Nothing is charged.",
  "items": [
    {
      "title": "No card, no charge",
      "text": "There is no checkout yet. A plan click only tells us which price makes sense to you."
    },
    {
      "title": "Hear when it launches",
      "text": "Join the waitlist from the same message and you’ll get one email, on launch day."
    }
  ],
  "itemStyle": "subheading",
  "primaryLabel": "See the plans",
  "secondaryLabel": "How this test works",
  "primaryHref": "/pricing/",
  "secondaryHref": "/legal/terms/#testing-interest",
  "imageAlt": "The message after a plan click: Studio isn't available yet and no payment was taken"
};
const section7: ComponentProps<typeof Pricing> = {
  "tagline": "Pricing",
  "heading": "Plans for one person or a whole studio",
  "description": "Monthly, no setup fee. Pick the plan that fits how many clients you bill."
};
const section8: ComponentProps<typeof Faq2> = {
  "look": "card",
  "heading": "Questions",
  "description": "Straight answers, including what Paylark won’t do.",
  "questions": [
    {
      "question": "Will my clients know the reminders are automated?",
      "answer": "They come from your address, in your words, so they read like your own follow-ups. Paylark adds no branding to them.",
      "open": true
    },
    {
      "question": "Can I stop the reminders for one client?",
      "answer": "Yes. Pause a client or a single invoice, and nothing more is sent until you resume it."
    },
    {
      "question": "Does Paylark take payments?",
      "answer": "No. Clients pay you as they do today, by bank transfer or through your own payment link. Paylark only sends the reminders."
    },
    {
      "question": "Which invoicing tools does it work with?",
      "answer": "At launch, forwarded invoice emails and CSV uploads. Other tools come next, starting with the ones people on the waitlist use most."
    },
    {
      "question": "When does Paylark launch?",
      "answer": "When enough people tell us they need it. Join the waitlist and you’ll get one email, on launch day."
    }
  ],
  "ctaLabel": "Ask a question",
  "ctaHref": `mailto:${site.legal.contactEmail}`
};
const jsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: (section8.questions ?? []).map((q) => ({ "@type": "Question", name: q.question, acceptedAnswer: { "@type": "Answer", text: q.answer } })),
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: site.product.name,
    description: site.product.description,
    ...(siteUrl && { url: siteUrl.toString() }),
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    ...(site.pricing.mode === "checkout" ? { offers: site.pricing.plans.filter((p) => p.checkoutUrl).map((p) => ({ "@type": "Offer", name: p.name, price: p.price.replace(/[^0-9.]/gu, ""), priceCurrency: "USD", url: p.checkoutUrl })) } : {}),
  },
];
const section9: ComponentProps<typeof CtaPanel> = {
  "heading": "Stop chasing invoices by hand",
  "description": "Join the waitlist and we’ll email you once, when Paylark launches."
};
---
<Base title={site.seo.title ?? `${site.product.name} — ${site.product.description}`} jsonLd={jsonLd}>
  <SiteHeader />
  <div data-section="2" style={mockup("hero-product")}>
    <Hero {...section2} />
  </div>
  {layout === "story" && (
    <>
      <div data-section="problem" style="display: contents">
        <span id="problem" aria-hidden="true"></span>
        <Feature155 {...problem} />
      </div>
      <div data-section="4" style="display: contents">
        <span id="solution" aria-hidden="true"></span>
        <StatsSection2 {...section4} />
      </div>
    </>
  )}
  {layout !== "minimal" && (
    <div data-section="3" style={mockup("how-it-works")}>
      <span id="how-it-works" aria-hidden="true"></span>
      <Feature459 {...section3} />
    </div>
  )}
  {layout === "product" && (
    <>
      <div data-section="4" style="display: contents">
        <StatsSection2 {...section4} />
      </div>
      <div data-section="5" style="display: contents">
        <Feature155 {...section5} />
      </div>
      <div data-section="6" style={mockup("fake-door")}>
        <Feature4 {...section6} />
      </div>
    </>
  )}
  {layout !== "minimal" && site.pricing.mode !== "off" && <Pricing id="pricing" {...section7} />}
  <div data-section="8" style="display: contents">
    <span id="faq" aria-hidden="true"></span>
    <Faq2 {...section8} />
  </div>
  {layout !== "minimal" && (
    <div data-section="9" style="display: contents">
      <CtaPanel {...section9} />
    </div>
  )}
  <SiteFooter />
</Base>

<!-- Product mockups: drawn from design/mockups/ in the preset's colours by src/pages/images/[mockup].svg.ts. -->
<style is:global>
  :is([data-section="2"] .hero-header-82__image, [data-section="3"] .feature-459__media, [data-section="6"] .feature-4__media) { background: var(--mockup) center / cover no-repeat; }
  :root[data-theme="dark"] :is([data-section="2"] .hero-header-82__image, [data-section="3"] .feature-459__media, [data-section="6"] .feature-4__media) { background-image: var(--mockup-dark); }
</style>
